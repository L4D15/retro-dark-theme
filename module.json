{
    "id": "retro-dark-theme",
    "title": "Retro - Dark Theme",
    "description": "Dark theme with old terminal vibes.",
    "authors": [
        {
            "name": "Ladislao Lainez"
        }
    ],
    "version": "3.3.0",
    "compatibility": {
        "minimum": "13",
        "verified": "14"
    },
    "esmodules": ["retro-dark-theme.bundle.mjs"],
    "styles": ["retro-dark-theme.css"],
    "languages": [
        {
            "lang": "en",
            "name": "English",
            "path": "lang/en.json"
        },
        {
            "lang": "es",
            "name": "Español",
            "path": "lang/es.json"
        }
    ],
    "flags": {
        "hotReload": {
            "extensions": ["css", "html", "json"],
            "paths": ["."]
        }
    },
    "manifest": "https://github.com/L4D15/retro-dark-theme/releases/latest/download/module.json",
    "download": "https://github.com/L4D15/retro-dark-theme/releases/download/3.3.0/retro-dark-theme.zip"
}
